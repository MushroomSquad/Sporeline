# Core default values. Runtimes override them in runtimes/<name>/defaults.env,
# the project — in .ci.yaml, the CI system — via environment variables.
# Legacy platform variable names (NEXUS_*, REGISTRY_*, CUSTOM_CA_*, ...) are used as value sources.

# --- General -------------------------------------------------------------------
HCI_SERVICE_TYPE="image"
HCI_STRICT="true"
HCI_SOFT_EXIT_CODE="78"
HCI_HOOKS_DIR=".ci/hooks"
HCI_OUT_DIR="hci-artifacts"
HCI_CACHE_DIR="${PWD}/.cache"
HCI_IMAGES_FOLDER="${DST_STORAGE_FOLDER:-hyperion}"
HCI_IMAGE_FLAVOR="$([[ "${CERTIFIED_BASE_IMAGE:-}" == "true" ]] && echo redos73-cert || echo ubi9)"
HCI_CODE_HASH="${CODE_HASH:-}"
HCI_VERSION=""
HCI_VERSION_STRIP_V="false"
HCI_PUBLISH_SNAPSHOTS="false"
HCI_RUNTIME_VERSION=""

# --- Registries -----------------------------------------------------------------
HCI_REGISTRY_SCHEME="${HTTP_SCHEMA:-https}"
HCI_REGISTRY_HOST="${NEXUS_HOST:-}"
HCI_REGISTRY_USER="${NEXUS_USER:-}"
HCI_REGISTRY_PASSWORD="${NEXUS_PASSWORD:-}"

HCI_REGISTRY_OCI_HOST="${REGISTRY_HOST:-$HCI_REGISTRY_HOST}"
HCI_REGISTRY_OCI_USER="${REGISTRY_USER:-$HCI_REGISTRY_USER}"
HCI_REGISTRY_OCI_PASSWORD="${REGISTRY_PASSWORD:-$HCI_REGISTRY_PASSWORD}"
HCI_REGISTRY_OCI_PUSH_HOST="${REGISTRY_INT_HOST:-$HCI_REGISTRY_OCI_HOST}"
HCI_REGISTRY_OCI_PUSH_USER="${REGISTRY_INT_USER:-$HCI_REGISTRY_OCI_USER}"
HCI_REGISTRY_OCI_PUSH_PASSWORD="${REGISTRY_INT_PASSWORD:-$HCI_REGISTRY_OCI_PASSWORD}"

HCI_REGISTRY_MAVEN_HOST="${MAVEN_REGISTRY_HOST:-${GRADLE_REGISTRY_HOST:-}}"
HCI_REGISTRY_MAVEN_USER="${MAVEN_REGISTRY_USER:-${GRADLE_REGISTRY_USER:-}}"
HCI_REGISTRY_MAVEN_PASSWORD="${MAVEN_REGISTRY_PASSWORD:-${GRADLE_REGISTRY_PASSWORD:-}}"
HCI_REGISTRY_NPM_HOST="${NPM_REGISTRY_HOST:-}"
HCI_REGISTRY_NPM_USER="${NPM_REGISTRY_USER:-}"
HCI_REGISTRY_NPM_PASSWORD="${NPM_REGISTRY_PASSWORD:-}"
HCI_REGISTRY_NUGET_HOST="${NUGET_REGISTRY_HOST:-}"
HCI_REGISTRY_NUGET_USER="${NUGET_REGISTRY_USER:-}"
HCI_REGISTRY_NUGET_PASSWORD="${NUGET_REGISTRY_PASSWORD:-}"
HCI_REGISTRY_PYPI_HOST="${PYPI_REGISTRY_HOST:-}"
HCI_REGISTRY_PYPI_USER="${PYPI_REGISTRY_USER:-}"
HCI_REGISTRY_PYPI_PASSWORD="${PYPI_REGISTRY_PASSWORD:-}"
HCI_REGISTRY_CARGO_HOST="${CARGO_REGISTRY_HOST:-}"
HCI_REGISTRY_CARGO_USER="${CARGO_REGISTRY_USER:-}"
HCI_REGISTRY_CARGO_PASSWORD="${CARGO_REGISTRY_PASSWORD:-}"
HCI_REGISTRY_GO_HOST="${GO_REGISTRY_HOST:-}"
HCI_REGISTRY_GO_USER="${GO_REGISTRY_USER:-}"
HCI_REGISTRY_GO_PASSWORD="${GO_REGISTRY_PASSWORD:-}"
HCI_REGISTRY_COMPOSER_HOST="${COMPOSER_REGISTRY_HOST:-}"
HCI_REGISTRY_COMPOSER_USER="${COMPOSER_REGISTRY_USER:-}"
HCI_REGISTRY_COMPOSER_PASSWORD="${COMPOSER_REGISTRY_PASSWORD:-}"
HCI_REGISTRY_MAVEN_PULL_REPO="repository/maven-public"
HCI_REGISTRY_MAVEN_REPO="repository/maven-releases"
HCI_REGISTRY_MAVEN_SNAPSHOT_REPO="repository/maven-snapshots"
HCI_REGISTRY_NPM_PULL_REPO="repository/npm-public"
HCI_REGISTRY_NPM_REPO="repository/npm-hosted"
HCI_REGISTRY_NUGET_PULL_REPO="repository/nuget-group"
HCI_REGISTRY_NUGET_REPO="repository/nuget-hosted"
HCI_REGISTRY_NUGET_API_KEY="${NUGET_API_KEY:-}"
HCI_REGISTRY_PYPI_PULL_REPO="repository/pypi-group"
HCI_REGISTRY_PYPI_REPO="repository/pypi-hosted"
HCI_REGISTRY_CARGO_PULL_REPO="repository/crates-group"
HCI_REGISTRY_CARGO_REPO="repository/crates-hosted"
HCI_REGISTRY_GO_PULL_REPO="repository/golang-proxy"
HCI_REGISTRY_GO_SUM_REPO="repository/golang-sum-proxy"
HCI_REGISTRY_COMPOSER_PULL_REPO="repository/packagist"
HCI_REGISTRY_HELM_REPO="repository/${HCI_IMAGES_FOLDER}-helm"
HCI_REGISTRY_HELM_HOST="${HELM_REGISTRY_HOST:-}"
HCI_REGISTRY_HELM_USER="${HELM_REGISTRY_USER:-}"
HCI_REGISTRY_HELM_PASSWORD="${HELM_REGISTRY_PASSWORD:-}"

# --- TLS ---------------------------------------------------------------------
HCI_CA_CERT="${CUSTOM_CA_CERT:-}"
HCI_CA_BUNDLE="${CUSTOM_CA_CERTS_BUNDLE:-${CUSTOM_CA_CERT:-}}"
HCI_TLS_INSECURE="false"
HCI_TRUSTSTORE_PASSWORD="changeit"

# --- Image build -----------------------------------------------------------
HCI_IMAGE_NAME=""
HCI_IMAGE_BUILD_MODE="auto"
HCI_IMAGE_DEFAULT_MODE="base"
HCI_IMAGE_DOCKERFILE=""
HCI_IMAGE_BUILD_CONTEXT="."
HCI_IMAGE_BUILD_ARGS=""
HCI_IMAGE_PLATFORMS="linux/amd64"
HCI_IMAGE_CONTEXT=""
HCI_IMAGE_CONTEXT_EXCLUDE=""
HCI_IMAGE_PASSWD="false"
HCI_IMAGE_WORKDIR="/opt/app-root/src"
HCI_IMAGE_CHOWN="1001:0"
HCI_IMAGE_USER=""
HCI_IMAGE_CMD=""
HCI_IMAGE_ENTRYPOINT=""
HCI_IMAGE_ENV=""
HCI_IMAGE_LABELS=""
HCI_IMAGE_PORTS=""
HCI_IMAGE_RUN=""
HCI_IMAGE_TAG_PREFIX=""
HCI_IMAGE_TAG_SUFFIX=""
HCI_IMAGE_EXTRA_TAGS=""
HCI_IMAGE_TAG_LATEST="false"
HCI_IMAGE_CACHE="true"
HCI_IMAGE_CACHE_REPO=""
HCI_OCI_DIR="oci-image"
HCI_RUNTIME_IMAGE=""
HCI_S2I_BUILDER_IMAGE=""
HCI_CEKIT_DESCRIPTOR="image.yaml"
HCI_CEKIT_OVERRIDE=""

# --- Scanning and SBOM -----------------------------------------------------
HCI_TRIVY_SERVER="${EXTERNAL_TRIVY_SERVER:-http://trivy:8080}"
HCI_TRIVY_TIMEOUT="10m"
# Standalone mode only (HCI_TRIVY_SERVER empty) — air-gapped vulnerability DB mirror.
HCI_TRIVY_DB_REPOSITORY=""
HCI_TRIVY_JAVA_DB_REPOSITORY=""
HCI_SCAN_FAIL_SEVERITY="CRITICAL"
HCI_SCAN_IGNORE_CVES="CVE-2019-1010022"
HCI_SCAN_REPORT="${HCI_OUT_DIR}/image-scan.json"
HCI_SBOM_FILE="${HCI_OUT_DIR}/sbom.cdx.json"
HCI_DEPS_REPORT="${HCI_OUT_DIR}/deps-scan.json"
HCI_DEPS_SBOM_FILE="${HCI_OUT_DIR}/deps-sbom.cdx.json"
HCI_DEPS_SKIP_DIRS=".git,.cache,node_modules,${HCI_OCI_DIR},${HCI_OUT_DIR}"

# --- Signing -----------------------------------------------------------------
HCI_COSIGN_KEY="${COSIGN_KEY:-}"
HCI_COSIGN_PASSWORD="${COSIGN_PASSWORD:-}"
HCI_COSIGN_TLOG="false"
HCI_COSIGN_ARGS=""
HCI_SIGN_REQUIRED="false"

# --- SonarQube ---------------------------------------------------------------
HCI_SONAR_HOST_URL="${SONAR_HOST:+${HCI_REGISTRY_SCHEME}://${SONAR_HOST}}"
HCI_SONAR_TOKEN="${SONAR_KEY:-${SONAR_TOKEN:-}}"
HCI_SONAR_PROJECT_KEY=""
HCI_SONAR_EXCLUSIONS=""
HCI_SONAR_PROJECT_NAME=""
HCI_SONAR_QUALITYGATE_WAIT="true"
HCI_SONAR_ARGS=""

# --- Svace -------------------------------------------------------------------
HCI_SVACE_HOST="${SVACE_HOST:-}"
HCI_SVACE_LOGIN="${SVACE_REMOTE_LOGIN:-}"
HCI_SVACE_PASSWORD="${SVACE_REMOTE_PASSWORD:-}"
HCI_SVACE_ARGS=""
HCI_SVACE_BUILD_CMD=""
HCI_SVACE_IMAGE_VERSION="0.7.0"

# --- AppScreener -------------------------------------------------------------
HCI_APPSCREENER_URL="${APPSCREENER_URL:-}"
HCI_APPSCREENER_TOKEN="${APPSCREENER_TOKEN:-}"
HCI_APPSCREENER_GROUP_UUID="${APPSCREENER_GROUP_UUID:-}"
HCI_APPSCREENER_PROJECT_UUID="${APPSCREENER_PROJECT_UUID:-}"
HCI_APPSCREENER_WAIT="true"
HCI_APPSCREENER_TIMEOUT="3600"
HCI_APPSCREENER_POLL_INTERVAL="15"
HCI_APPSCREENER_EXCLUDES=".git,.cache,node_modules,target,build,.venv,${HCI_OUT_DIR}"
HCI_APPSCREENER_REPORT="${HCI_OUT_DIR}/appscreener.json"

# --- Kaspersky Container Security -------------------------------------------
HCI_KCS_URL="${KASPERSKY_URL:-}"
HCI_KCS_TOKEN="${KASPERSKY_TOKEN:-}"
HCI_KCS_REPORT="${HCI_OUT_DIR}/kcs-report.json"
HCI_KCS_ENTRYPOINT="/entrypoint.sh"
HCI_KCS_SKIP_API_VALIDATION="true"

# --- Helm --------------------------------------------------------------------
HCI_HELM_CHART_DIR="."
HCI_HELM_PUBLISH_MODE="nexus"
HCI_HELM_VALUES="values.yaml"
HCI_HELM_KUBECONFORM_ARGS="-strict -ignore-missing-schemas -summary"

# --- CD/GitOps ----------------------------------------------------------------
HCI_CD_GIT_URL=""
HCI_CD_GIT_BRANCH=""
HCI_CD_GIT_TOKEN=""
HCI_CD_GIT_USER="oauth2"
HCI_CD_GIT_SSH_KEY=""
HCI_CD_GIT_SSH_KNOWN_HOSTS=""
HCI_CD_GIT_SSH_INSECURE="false"
HCI_CD_GIT_USER_NAME="hyperion-ci"
HCI_CD_GIT_USER_EMAIL="ci@localhost"
HCI_CD_IMAGE=""
HCI_CD_YAML_FILE=""
HCI_CD_YAML_PATH=""
HCI_CD_NOTIFY_URL=""
HCI_CD_NOTIFY_METHOD="POST"
HCI_CD_NOTIFY_TOKEN=""
HCI_CD_NOTIFY_BODY=""
HCI_CD_NOTIFY_TIMEOUT="30"
