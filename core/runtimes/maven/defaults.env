# Maven
HCI_JACOCO_VERSION="0.8.14"
HCI_MAVEN_WRAPPER="auto"
HCI_MAVEN_ARGS=""
HCI_MAVEN_BUILD_PHASE="package"
HCI_MAVEN_SET_VERSION="true"
HCI_MAVEN_THREADS="1C"
HCI_MAVEN_TEST_GOALS="org.jacoco:jacoco-maven-plugin:${HCI_JACOCO_VERSION:-0.8.14}:prepare-agent surefire:test failsafe:integration-test failsafe:verify org.jacoco:jacoco-maven-plugin:${HCI_JACOCO_VERSION:-0.8.14}:report"
HCI_MAVEN_PUBLISH_GOALS="source:jar javadoc:jar jar:jar"
HCI_MAVEN_DEPLOY_PLUGIN="org.apache.maven.plugins:maven-deploy-plugin:3.1.3"
HCI_MAVEN_COVERAGE_FILES="**/target/site/jacoco/jacoco.xml"
MAVEN_OPTS="${MAVEN_OPTS:--Djava.awt.headless=true -Dfile.encoding=UTF-8}"

# Image: jar files in /deployments of the openjdk-runtime image (run-java.sh).
HCI_IMAGE_WORKDIR="/deployments"
HCI_IMAGE_CONTEXT="target/*.jar"
HCI_IMAGE_CONTEXT_EXCLUDE="*-sources.jar,*-javadoc.jar,*-tests.jar,original-*.jar"
HCI_IMAGE_PORTS="8080"
HCI_IMAGE_CHOWN="185:0"

HCI_SVACE_ARGS="--enable-spotbugs --spotbugs-memory 8192"
