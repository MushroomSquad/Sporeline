# Quarkus (fast-jar): в образ копируется target/quarkus-app целиком, покрытие — quarkus-jacoco.
HCI_MAVEN_ARGS="-Dquarkus.package.jar.type=fast-jar -Djacoco.exclClassLoaders=*QuarkusClassLoader ${HCI_MAVEN_ARGS:-}"
HCI_MAVEN_TEST_GOALS="surefire:test failsafe:integration-test failsafe:verify"
HCI_MAVEN_COVERAGE_FILES="**/target/jacoco-report/jacoco.xml"
HCI_IMAGE_CONTEXT="target/quarkus-app"
HCI_IMAGE_CONTEXT_EXCLUDE=""
HCI_IMAGE_ENV="JAVA_APP_JAR=/deployments/quarkus-run.jar"$'\n'"JAVA_MAX_HEAP=${HCI_JAVA_MAX_HEAP:-1g}"
