HCI_GO_BINARY="app"
HCI_GO_CONTEXT="./"
HCI_GO_TAGS="osusergo netgo static_build"
HCI_GO_LDFLAGS="-w -extldflags -fno-PIC -static"
HCI_IMAGE_CONTEXT="app"
HCI_IMAGE_WORKDIR="/usr/bin"
HCI_IMAGE_CHOWN="1001:0"
HCI_IMAGE_USER="1001"
HCI_IMAGE_ENTRYPOINT="/usr/bin/app"
HCI_IMAGE_PASSWD="true"
HCI_IMAGE_PORTS="8080"
HCI_SVACE_ARGS="--init --go-interception-mode go-build"
