HCI_PYTHON_PACKAGE_MANAGER="auto"
HCI_PYTHON_EXTRAS=""
HCI_IMAGE_CONTEXT=".venv,src,app,.hci-install.sh,requirements.txt,pyproject.toml"
HCI_IMAGE_CONTEXT_EXCLUDE="**/*.pyc,**/.pytest_cache"
HCI_IMAGE_WORKDIR="/opt/app-root/src"
HCI_IMAGE_CMD=".hci-install.sh || python -m app"
HCI_IMAGE_PORTS="8080"
HCI_IMAGE_RUN="if [ -f .hci-install.sh ]; then sh .hci-install.sh; fi"
