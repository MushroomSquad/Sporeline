HCI_GRADLE_WRAPPER="auto"
HCI_GRADLE_ARGS=""
HCI_GRADLE_BUILD_TASKS="clean assemble"
HCI_JACOCO_VERSION="0.8.12"
HCI_IMAGE_WORKDIR="/deployments"
HCI_IMAGE_CONTEXT="build/libs/*.jar"
HCI_IMAGE_CONTEXT_EXCLUDE="*-sources.jar,*-javadoc.jar,*-plain.jar"
HCI_IMAGE_PORTS="8080"
HCI_IMAGE_CHOWN="185:0"
HCI_SVACE_ARGS="--enable-spotbugs --spotbugs-memory 8192"
HCI_GRADLE_GROUP=""
